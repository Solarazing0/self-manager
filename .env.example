SELF_PORT=4317
SELF_DB=data/self.sqlite
SELF_TIME_ZONE=Europe/Moscow
# Default quiet hours for Web Push in SELF_TIME_ZONE. Use off to disable quiet hours.
# SELF_QUIET_HOURS=22:00-08:00
# Optional HTTPS URL or mailto contact for browser push services.
# SELF_PUSH_CONTACT=mailto:you@example.org
# Set both variables to enable the cloud Legion. Choose the exact API model yourself.
# OPENAI_API_KEY=
# LEGION_MODEL=gpt-6-luna
# When serving through an HTTPS proxy with authentication, configure its public origin.
# SELF_PUBLIC_ORIGIN=https://self.example.org
